# Salin ke .env lalu isi nilainya:  cp .env.example .env && chmod 600 .env
#
# File .env TIDAK ikut ke Git (ada di .gitignore). Kalau restore repo dari
# GitHub di mesin baru, file ini harus dibuat ulang manual — kalau lupa,
# farm bakal gagal dengan "No address associated with hostname" karena
# kode jatuh ke placeholder mail.example.com.

# --- WAJIB ---
# Base URL API temp mail. Harus endpoint yang menyediakan /session, /inboxes,
# /inboxes/{addr}/messages. Jangan pakai placeholder.
TEMPIK_BASE=https://mail.xentranetwork.me/api

# --- OPSIONAL ---
# Kosongkan untuk jalan langsung dari IP server (aman sampai ~120 signup/IP).
# Isi dengan bridge rotating kalau kena TOO_MANY_ATTEMPTS_TRY_LATER.
ADCODE_PROXY=

# Jumlah worker paralel. >3 bikin Firebase balas QUOTA_EXCEEDED pada kirim OTP.
ADCODE_WORKERS=2

# Jeda antar attempt (detik).
ADCODE_GAP=1
